<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme is a thin shell: all real theming is done in Compose
         (ui/theme/Theme.kt). -->
    <style name="Theme.KitWallet" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.KitWallet.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/kit_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.KitWallet</item>
    </style>

    <!-- A share can take long enough to copy that this must be a real Activity theme. Android
         requires Theme.NoDisplay activities to finish before onResume; using it while staging a
         large attachment made the system close Kit Pay before the recipient picker opened. -->
    <style name="Theme.KitWallet.ShareRelay" parent="Theme.KitWallet">
        <item name="android:windowBackground">@color/kit_navy</item>
    </style>

    <!-- A validated incoming call uses this real, fully opaque window to wake a locked device.
         MainActivity keeps the same navy starting window until its Compose privacy cover has
         drawn, so no previously visible wallet or conversation frame can flash over keyguard. -->
    <style name="Theme.KitWallet.CallRelay" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/kit_navy</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
